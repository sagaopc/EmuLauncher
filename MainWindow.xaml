<Window x:Class="EmuLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:EmuLauncher.Services"
        Title="Emu Launcher"
        Width="1296" Height="768"
        MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextMain}"
        FontFamily="./Fonts/#Inter, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- An emulator in the home row: its icon (or two letters), its name, a dot when an update is waiting. -->
        <DataTemplate x:Key="EmulatorTile">
            <Button Style="{StaticResource TileButton}"
                    Margin="0,0,6,0"
                    Click="Tile_Click"
                    GotKeyboardFocus="Tile_GotFocus"
                    MouseDoubleClick="Tile_DoubleClick">
                <StackPanel Width="144">
                    <Grid Width="144" Height="144">
                        <Border CornerRadius="18" Background="{StaticResource Placeholder}" />
                        <TextBlock x:Name="Mono"
                                   Text="{Binding Monogram}"
                                   FontSize="40"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource IconIdle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <Image Source="{Binding Icon}"
                               Margin="26"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Ellipse x:Name="Dot"
                                 Width="16" Height="16"
                                 Margin="0,9,9,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Fill="{StaticResource Accent}"
                                 Stroke="{StaticResource Placeholder}"
                                 StrokeThickness="3"
                                 Visibility="Collapsed" />
                    </Grid>
                    <TextBlock Text="{Binding Name}"
                               Margin="0,11,0,2"
                               FontSize="15"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Mono" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An emulator on the download page. -->
        <DataTemplate x:Key="CatalogCard">
            <Button Style="{StaticResource CardButton}"
                    Width="344" Height="96"
                    Margin="0,0,12,12"
                    Click="Catalog_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="62" Height="62"
                            CornerRadius="13"
                            Background="{StaticResource Placeholder}">
                        <TextBlock Text="{Binding Monogram}"
                                   FontSize="20"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="19"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Platform}"
                                   Margin="0,2,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="State"
                                   Text="{Binding State}"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource IconIdle}" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Installed}" Value="True">
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <!-- The stage is laid out for a 720-line screen and scaled to the window, so text and
         tiles keep their size on a television whatever its resolution. -->
    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
        <Grid x:Name="Stage">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <!-- "Contained": at the edge of the screen a direction stops instead of wrapping around. -->
            <Grid x:Name="Shell" KeyboardNavigation.DirectionalNavigation="Contained">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Rail -->
                <Border Background="{StaticResource RailBg}">
                    <DockPanel Margin="0,22,0,22" LastChildFill="False">
                        <Button x:Name="RailLibrary"
                                DockPanel.Dock="Top"
                                Style="{StaticResource RailButton}"
                                Margin="0,0,0,10"
                                ToolTip="{x:Static s:T.Library}"
                                Click="RailLibrary_Click">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconLibrary}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="RailCatalog"
                                DockPanel.Dock="Top"
                                Style="{StaticResource RailButton}"
                                Margin="0,0,0,10"
                                ToolTip="{x:Static s:T.Download}"
                                Click="RailCatalog_Click">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconDownload}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="RailSettings"
                                DockPanel.Dock="Top"
                                Style="{StaticResource RailButton}"
                                ToolTip="{x:Static s:T.Settings}"
                                Click="RailSettings_Click">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconSettings}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="RailExit"
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource RailButton}"
                                ToolTip="{x:Static s:T.Exit}"
                                Click="Exit_Click">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconPower}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="RailFullscreen"
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource RailButton}"
                                Margin="0,0,0,10"
                                ToolTip="{x:Static s:T.Fullscreen}"
                                Click="Fullscreen_Click">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconFullscreen}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Home: one big card for the selected emulator, the others in a row below. -->
                    <Grid x:Name="HomePage" Margin="64,56,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,64,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="HeroCover" Width="236" Height="236" Margin="0,0,44,0">
                                <Border CornerRadius="26" Background="{StaticResource Placeholder}" />
                                <TextBlock x:Name="HeroMono"
                                           FontSize="68"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource IconIdle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image x:Name="HeroIcon"
                                       Margin="40"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroPlatform" Style="{StaticResource Section}" Margin="1,0,0,4" />
                                <TextBlock x:Name="HeroTitle"
                                           FontSize="44"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel x:Name="HeroStatusRow" Orientation="Horizontal" Margin="1,8,0,0">
                                    <Ellipse x:Name="HeroDot"
                                             Width="10" Height="10"
                                             Margin="0,1,10,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeroStatus"
                                               FontSize="18"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <TextBlock x:Name="HeroHint"
                                           Margin="1,8,0,0"
                                           MaxWidth="640"
                                           HorizontalAlignment="Left"
                                           FontSize="18"
                                           LineHeight="26"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}"
                                           Visibility="Collapsed" />

                                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                                    <Button x:Name="PlayButton"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="Play_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox x:Name="PlayGlyph" Width="24" Height="24" Margin="0,0,10,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconPlay}"
                                                          Fill="{StaticResource OnAccent}"
                                                          Stroke="{StaticResource OnAccent}"
                                                          StrokeThickness="1.8"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox x:Name="InstallGlyph" Width="24" Height="24" Margin="0,0,10,0" Visibility="Collapsed">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconDownload}"
                                                          Stroke="{StaticResource OnAccent}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="PlayText" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="UpdateButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="14,0,0,0"
                                            Click="Update_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconRefresh}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{x:Static s:T.Update}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OptionsButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Click="Options_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconMenu}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{x:Static s:T.Options}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource Section}"
                                   Margin="1,46,0,10"
                                   Text="{x:Static s:T.YourEmulators}" />

                        <ScrollViewer x:Name="RowScroll"
                                      Grid.Row="2"
                                      Margin="-13,0,0,0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="RowScroll_PreviewMouseWheel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,58,0">
                                <ItemsControl x:Name="EmulatorRow"
                                              Focusable="False"
                                              ItemsSource="{Binding Emulators}"
                                              ItemTemplate="{StaticResource EmulatorTile}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Button x:Name="AddTile"
                                        Style="{StaticResource TileButton}"
                                        Click="RailCatalog_Click">
                                    <StackPanel Width="144">
                                        <Grid Width="144" Height="144">
                                            <Border CornerRadius="18"
                                                    BorderBrush="{StaticResource Line}"
                                                    BorderThickness="2" />
                                            <Viewbox Width="48" Height="48">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconPlus}"
                                                          Stroke="{StaticResource IconIdle}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <TextBlock Text="{x:Static s:T.Download}"
                                                   Margin="0,11,0,2"
                                                   FontSize="15"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Download: the catalog of emulators the launcher can install. -->
                    <Grid x:Name="CatalogPage" Margin="64,50,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,64,22">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static s:T.CatalogTitle}" />
                            <TextBlock Style="{StaticResource Section}"
                                       Margin="1,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="{x:Static s:T.CatalogSubtitle}" />
                        </StackPanel>

                        <ScrollViewer x:Name="CatalogScroll"
                                      Grid.Row="1"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="0,3,40,24">
                                <ItemsControl x:Name="CatalogList"
                                              Focusable="False"
                                              ItemsSource="{Binding CatalogItems}"
                                              ItemTemplate="{StaticResource CatalogCard}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Button x:Name="AddCustomButton"
                                        Style="{StaticResource CardButton}"
                                        Width="700"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Click="AddCustom_Click">
                                    <StackPanel Margin="6,2,6,2">
                                        <TextBlock Text="{x:Static s:T.AddCustom}" FontSize="18" />
                                        <TextBlock Text="{x:Static s:T.AddCustomHint}"
                                                   Margin="0,3,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Settings -->
                    <Grid x:Name="SettingsPage" Margin="64,50,64,0" Visibility="Collapsed">
                        <StackPanel Width="780" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource PageTitle}"
                                       Margin="0,0,0,20"
                                       Text="{x:Static s:T.SettingsTitle}" />

                            <Button x:Name="FolderRow" Style="{StaticResource OptionButton}" Click="SetFolder_Click">
                                <DockPanel>
                                    <TextBlock x:Name="FolderValue"
                                               DockPanel.Dock="Right"
                                               MaxWidth="470"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Static s:T.SettingFolder}" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="FullscreenRow" Style="{StaticResource OptionButton}" Click="SetFullscreen_Click">
                                <DockPanel>
                                    <TextBlock x:Name="FullscreenValue"
                                               DockPanel.Dock="Right"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{x:Static s:T.SettingFullscreen}" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="CheckOnStartRow" Style="{StaticResource OptionButton}" Click="SetCheckOnStart_Click">
                                <DockPanel>
                                    <TextBlock x:Name="CheckOnStartValue"
                                               DockPanel.Dock="Right"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{x:Static s:T.SettingCheckOnStart}" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="CheckNowRow" Style="{StaticResource OptionButton}" Click="SetCheckNow_Click">
                                <TextBlock Text="{x:Static s:T.SettingCheckNow}" />
                            </Button>
                            <Button x:Name="ExitRow" Style="{StaticResource OptionButton}" Click="Exit_Click">
                                <TextBlock Text="{x:Static s:T.SettingExit}" />
                            </Button>

                            <TextBlock x:Name="AboutText"
                                       Margin="20,24,20,0"
                                       FontSize="14"
                                       LineHeight="21"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource IconIdle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer: what is going on, and what the buttons do. -->
                    <Grid Grid.Row="1" Height="34" Margin="64,10,64,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   Margin="1,0,24,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="Hints"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Dialogs sit over the shell, which is disabled meanwhile so focus stays inside them. -->
            <Grid x:Name="OverlayLayer" Background="#D908080A" Visibility="Collapsed">

                <Border x:Name="DialogPanel"
                        Width="660"
                        MaxHeight="610"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,26,28,20"
                        Background="{StaticResource Raised}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="DialogTitle"
                                   DockPanel.Dock="Top"
                                   FontSize="27"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DialogBody"
                                   DockPanel.Dock="Top"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   LineHeight="23"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ScrollViewer Margin="-12,18,-12,0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="DialogOptions"
                                        Margin="0,0,0,2"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border x:Name="ProgressPanel"
                        Width="660"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,26,28,24"
                        Background="{StaticResource Raised}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProgressTitle"
                                   FontSize="27"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProgressMessage"
                                   Margin="0,10,0,20"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="InstallProgress"
                                     Style="{StaticResource Bar}"
                                     Minimum="0"
                                     Maximum="100" />
                        <Button x:Name="ProgressCancel"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Content="{x:Static s:T.Cancel}"
                                Click="ProgressCancel_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
