<Window x:Class="EmuLauncher.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:EmuLauncher.Services"
        Title="Emu Launcher"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextMain}"
        FontFamily="./Fonts/#Inter, Segoe UI"
        UseLayoutRounding="True">

    <!-- The one screen that needs a mouse and a keyboard: paths and URLs are typed here. -->
    <StackPanel Margin="24,22,24,22">

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static s:T.Name}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static s:T.SystemName}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PlatformBox" Style="{StaticResource Input}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{x:Static s:T.RepoUrl}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="RepoBox" Style="{StaticResource Input}" />
        <TextBlock Text="{x:Static s:T.RepoHint}" Style="{StaticResource FieldHint}" Margin="1,5,0,14" />

        <TextBlock Text="{x:Static s:T.TagFilter}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FilterBox" Style="{StaticResource Input}" />
        <TextBlock Text="{x:Static s:T.TagFilterHint}" Style="{StaticResource FieldHint}" Margin="1,5,0,14" />

        <TextBlock Text="{x:Static s:T.InstallDir}" Style="{StaticResource FieldLabel}" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DirBox" Style="{StaticResource Input}" />
            <Button Grid.Column="1"
                    Content="{x:Static s:T.Browse}"
                    Style="{StaticResource FormButton}"
                    Margin="8,0,0,0"
                    Click="BrowseDir_Click" />
        </Grid>

        <TextBlock Text="{x:Static s:T.ExePath}" Style="{StaticResource FieldLabel}" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExeBox" Style="{StaticResource Input}" />
            <Button Grid.Column="1"
                    Content="{x:Static s:T.Browse}"
                    Style="{StaticResource FormButton}"
                    Margin="8,0,0,0"
                    Click="BrowseExe_Click" />
        </Grid>

        <TextBlock Text="{x:Static s:T.Arguments}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ArgsBox" Style="{StaticResource Input}" Margin="0,0,0,14" />

        <TextBlock Text="{x:Static s:T.IconPath}" Style="{StaticResource FieldLabel}" />
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IconBox" Style="{StaticResource Input}" />
            <Button Grid.Column="1"
                    Content="{x:Static s:T.Browse}"
                    Style="{StaticResource FormButton}"
                    Margin="8,0,0,0"
                    Click="BrowseIcon_Click" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="RemoveButton"
                    Content="{x:Static s:T.Remove}"
                    Style="{StaticResource FormButton}"
                    Foreground="{StaticResource TextSecondary}"
                    Click="Remove_Click" />

            <Button Grid.Column="2"
                    Content="{x:Static s:T.Cancel}"
                    Style="{StaticResource FormButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />

            <Button Grid.Column="3"
                    Content="{x:Static s:T.Save}"
                    Style="{StaticResource FormAccentButton}"
                    IsDefault="True"
                    Click="Save_Click" />
        </Grid>
    </StackPanel>
</Window>
